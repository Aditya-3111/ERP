# ======================================================================
#  FinLedger Pro - backend settings.   Copy this file to ".env" and edit.
#  (The real ".env" is private - never upload it to GitHub.)
# ======================================================================

# ---- MySQL / MariaDB login (XAMPP, MySQL Installer, Docker ... any works)
# The database and all tables are created automatically on first start,
# so this user must be allowed to create databases (root can).
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=finledger_pro

# ---- First start: create database + tables + starting data automatically
AUTO_SETUP_DB=true
# Fill the system with sample customers, items, employees, vouchers ...
# Set to false for a clean, empty system.
SEED_DEMO_DATA=true

# ---- The first login that is created for you
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@finledger.local

# ---- Django
SECRET_KEY=change-me-to-a-long-random-text
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ---- Websites allowed to call this API (the React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
